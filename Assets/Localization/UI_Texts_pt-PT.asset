  m_Name: UI_Texts_pt-PT
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-PT
  m_SharedData: {fileID: 11400000, guid: 238e9805e4df7fe47a8f15e77b1ead37, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 825082089472
    m_Localized: Jogar
    m_Metadata:
      m_Items: []
  - m_Id: 3347481989120
    m_Localized: "Defini\xE7\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 4188599324672
    m_Localized: "Cr\xE9ditos"
    m_Metadata:
      m_Items: []
  - m_Id: 4372897042432
    m_Localized: Sair
    m_Metadata:
      m_Items: []
  - m_Id: 4956215676928
    m_Localized: "Vers\xE3o 2.0"
    m_Metadata:
      m_Items: []
  - m_Id: 5533544845312
    m_Localized: VOLTAR
    m_Metadata:
      m_Items: []
  - m_Id: 5688759259136
    m_Localized: "CAP\xCDTULO 1"
    m_Metadata:
      m_Items: []
  - m_Id: 5873228943360
    m_Localized: Embarca nesta aventura e desvenda enigmas para desarmares uma bomba
      antes que o tempo se esgote.
    m_Metadata:
      m_Items: []
  - m_Id: 8901503848448
    m_Localized: "CAP\xCDTULO 2"
    m_Metadata:
      m_Items: []
  - m_Id: 8986241372160
    m_Localized: "CAP\xCDTULO 3"
    m_Metadata:
      m_Items: []
  - m_Id: 8999528927232
    m_Localized: "CAP\xCDTULO 4"
    m_Metadata:
      m_Items: []
  - m_Id: 9655660679168
    m_Localized: "Como resolver\xE1s o mist\xE9rio de uma simples carruagem? Para
      que servem estas alavancas?"
    m_Metadata:
      m_Items: []
  - m_Id: 9673054457856
    m_Localized: "Ser\xE1 apenas uma cozinha... ou algo mais?"
    m_Metadata:
      m_Items: []
  - m_Id: 9686098743296
    m_Localized: "Cada segundo conta. Ser\xE1s capaz de evitar a explos\xE3o?"
    m_Metadata:
      m_Items: []
  - m_Id: 14744316121088
    m_Localized: "Pressiona \"E\" para avan\xE7ar"
    m_Metadata:
      m_Items: []
  - m_Id: 27407620345856
    m_Localized: "M\xFAsica"
    m_Metadata:
      m_Items: []
  - m_Id: 27542525939712
    m_Localized: Efeitos Sonoros
    m_Metadata:
      m_Items: []
  - m_Id: 29074113794048
    m_Localized: Ligado
    m_Metadata:
      m_Items: []
  - m_Id: 29215176626176
    m_Localized: Desligado
    m_Metadata:
      m_Items: []
  - m_Id: 42789324296192
    m_Localized: Idioma
    m_Metadata:
      m_Items: []
  - m_Id: 47072874696704
    m_Localized: NOVO BILHETE
    m_Metadata:
      m_Items: []
  - m_Id: 47857704472576
    m_Localized: Movimento
    m_Metadata:
      m_Items: []
  - m_Id: 48015326416896
    m_Localized: Andar
    m_Metadata:
      m_Items: []
  - m_Id: 48110587449344
    m_Localized: "Intera\xE7\xF5es"
    m_Metadata:
      m_Items: []
  - m_Id: 48194863599616
    m_Localized: Bloco de Notas
    m_Metadata:
      m_Items: []
  - m_Id: 48361016758272
    m_Localized: Examinar e Falar
    m_Metadata:
      m_Items: []
  - m_Id: 48695961292800
    m_Localized: Pousar
    m_Metadata:
      m_Items: []
  - m_Id: 48788667994112
    m_Localized: Habilidades
    m_Metadata:
      m_Items: []
  - m_Id: 49237622099968
    m_Localized: "Virar ao Contr\xE1rio"
    m_Metadata:
      m_Items: []
  - m_Id: 51920328298496
    m_Localized: "\"E\" Avan\xE7ar\n\"F\" Sair"
    m_Metadata:
      m_Items: []
  - m_Id: 52919147270144
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 53426813243392
    m_Localized: Controlos
    m_Metadata:
      m_Items: []
  - m_Id: 55195844841472
    m_Localized: '

      "F" Sair'
    m_Metadata:
      m_Items: []
  - m_Id: 55309858607104
    m_Localized: '"F" Pousar

'
    m_Metadata:
      m_Items: []
  - m_Id: 56020071714816
    m_Localized: '"E" Atribuir'
    m_Metadata:
      m_Items: []
  - m_Id: 57221425238016
    m_Localized: Pressiona"E" para interagir
    m_Metadata:
      m_Items: []
  - m_Id: 57741414076416
    m_Localized: "Duas mesas, uma escolha. \nA primeira guarda, a segunda engana. "
    m_Metadata:
      m_Items: []
  - m_Id: 60020938608640
    m_Localized: "Sobre a madeira repousa, \naquilo que portas destrancam."
    m_Metadata:
      m_Items: []
  - m_Id: 61841845358592
    m_Localized: "N\xE3o vou conseguir abrir a porta sem uma chave."
    m_Metadata:
      m_Items: []
  - m_Id: 61970266558464
    m_Localized: "O cofre abre com um c\xF3digo de 4 d\xEDgitos."
    m_Metadata:
      m_Items: []
  - m_Id: 62751736696832
    m_Localized: "Eu j\xE1 vi isto antes..."
    m_Metadata:
      m_Items: []
  - m_Id: 63788618977280
    m_Localized: "Pressiona \"2\" para virar ao contr\xE1rio"
    m_Metadata:
      m_Items: []
  - m_Id: 286971745898496
    m_Localized: "Sentiu a minha falta, \r\nDetetive? \r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 287047151095808
    m_Localized: "Confesso que desde o \r\nincidente das sardinhas andava aborrecido."
    m_Metadata:
      m_Items: []
  - m_Id: 287821558026240
    m_Localized: "N\xE3o pode ser uma mera \r\ncoincid\xEAncia..."
    m_Metadata:
      m_Items: []
  - m_Id: 287982342475776
    m_Localized: "Porque \xE9 que ele voltou agora?\n\r\n\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 286731525525504
    m_Localized: "Sinto que estes m\xF3veis \r\nescondem alguma coisa."
    m_Metadata:
      m_Items: []
  - m_Id: 288697735548928
    m_Localized: Cima
    m_Metadata:
      m_Items: []
  - m_Id: 288728370745344
    m_Localized: Meio
    m_Metadata:
      m_Items: []
  - m_Id: 288760163569664
    m_Localized: Baixo
    m_Metadata:
      m_Items: []
  - m_Id: 391283230740480
    m_Localized: "O chef mencionou algo\nsobre o c\xF3digo e o menu."
    m_Metadata:
      m_Items: []
  - m_Id: 391425392480256
    m_Localized: "Tenho de falar com o chef, deve saber a quem \npertencem estes
      pedidos."
    m_Metadata:
      m_Items: []
  - m_Id: 391754691481600
    m_Localized: "Cliente 1: Repetia tudo\nCliente 2: Babava-se \nCliente 3: Arranhava\nCliente
      4: Pediu moscas"
    m_Metadata:
      m_Items: []
  - m_Id: 394942865838080
    m_Localized: "Estes fios s\xE3o resistentes, \nn\xE3o consigo cort\xE1-los."
    m_Metadata:
      m_Items: []
  - m_Id: 395118980468736
    m_Localized: "Os s\xEDmbolos parecem ter \num ritmo pr\xF3prio..."
    m_Metadata:
      m_Items: []
  - m_Id: 395270885576704
    m_Localized: "Vidro n\xE3o parte sozinho, um \nmartelo resolvia logo isto!"
    m_Metadata:
      m_Items: []
  - m_Id: 395461546053632
    m_Localized: "Faltam peda\xE7os..."
    m_Metadata:
      m_Items: []
  - m_Id: 397784863313920
    m_Localized: "Quatro decis\xF5es pelo caminho,\nA primeira acorda, a segunda
      adormece,\nA terceira desperta, a quarta descansa,\nS\xF3 quem seguir a ordem
      certa avan\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 398606632325120
    m_Localized: "PRESSIONAR O BOT\xC3O PARA VALIDAR"
    m_Metadata:
      m_Items: []
  - m_Id: 398744364879872
    m_Localized: "AO COMPLETAR TODOS OS M\xD3DULOS"
    m_Metadata:
      m_Items: []
  - m_Id: 399266601865216
    m_Localized: CONFIRMAR
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
