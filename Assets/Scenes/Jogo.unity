--- !u!114 &1126485068
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1126485067}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83189876d4d389f43b7dd2e925aa112e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueEditor.NPCConversation
  CurrentIDCounter: 22
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":9.600037,\"yPos\":24.7990875},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sou
    todo ouvidos\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":3.20004272,\"yPos\":206.200287},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sou
    sociopata, mas infelizmente comunicar \xE9 o meu trabalho\",\"parentUIDs\":[10],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-4.79995728,\"yPos\":379.20047},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Consumir
    tanta informa\xE7\xE3o a esta hora \xE9 pecado...\",\"parentUIDs\":[12],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-3.79995728,\"yPos\":538.2016},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Espero
    que estejam bem presas\",\"parentUIDs\":[13],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-6.79995728,\"yPos\":699.201},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Eu
    consegui resolver um caso tendo apenas uma lata de sardinhas, sem as sardinhas\",\"parentUIDs\":[14],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-8.799957,\"yPos\":887.2005},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Obrigado\",\"parentUIDs\":[15],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":10.2000427,\"yPos\":-82.8009949},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Antes
    que se ponha a explorar, deixe-me dar-lhe umas dicas, este comboio tem as suas
    particularidades.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Coruja\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0.1,\"Volume\":0.1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":6.200058,\"yPos\":101.999268},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Se
    vir algum objeto que lhe desperte a curiosidade, ou quiser meter conversa com
    algum passageiro, basta pressionar 'E'. Se n\xE3o quiser andar com as m\xE3os
    ocupadas, pode largar pressionando 'F'.\",\"parentUIDs\":[16],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Coruja\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-3.399887,\"yPos\":283.2002},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Agora,
    a mem\xF3ria j\xE1 n\xE3o \xE9 o que era, pois n\xE3o? Sempre que encontrar uma
    pista, pressione 'E' para a apontar no bloco de notas. Depois, quando precisar
    de consultar, \xE9 s\xF3 pressionar 'G'. Vai dar jeito para n\xE3o se perder
    no meio de tanta informa\xE7\xE3o.\",\"parentUIDs\":[17],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Coruja\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-5.79992676,\"yPos\":444.401062},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Se
    algo lhe parecer fora do s\xEDtio, experimente mudar de perspetiva. Aquelas barras
    por cima dos bancos n\xE3o est\xE3o ali s\xF3 para enfeitar. Aproxime-se de uma
    e pressione 'C' para ficar pendurado.\",\"parentUIDs\":[18],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Coruja\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":20}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-5.39990234,\"yPos\":602.8012},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Por
    \xFAltimo, este comboio j\xE1 teve os seus dias de gl\xF3ria. Se pressionar 'N',
    deve conseguir recuperar algumas informa\xE7\xF5es mais apagadas.\",\"parentUIDs\":[19],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Coruja\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.1},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-3.59991455,\"yPos\":783.0003},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
    caso de ter mais alguma d\xFAvida, pode voltar a falar comigo ou consultar os
    controlos no menu de pausa. Boa sorte.\",\"parentUIDs\":[20],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Coruja\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.1}]}"
